{
  "name": "tapwheel-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "tapwheel.app", "custom_domain": true },
    // the old address stays attached so its DNS stays proxied; a Cloudflare Redirect Rule sends it to tapwheel.app
    { "pattern": "tapwheel.muxover.com", "custom_domain": true }
  ]
}
